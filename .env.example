# OfferShield environment variables
#
# These values are SERVER-SIDE ONLY. Never prefix any of them with
# NEXT_PUBLIC_, because anything with that prefix is exposed to the browser.
#
# The app works without an AI provider configured: only the deterministic
# rule-based review runs and the UI says "Rule-based review only."

# Required for optional AI review. Use an OpenAI-compatible provider.
LLM_BASE_URL=https://your-openai-compatible-endpoint.example/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=your-model-name

# Optional: bounded request timeout in milliseconds (2000-60000, default 15000).
# LLM_TIMEOUT_MS=15000

# Optional: set to json_object only if your provider supports
# response_format: { "type": "json_object" }. Leave unset for providers that
# do not support structured-output options; the adapter still parses plain
# JSON text from the model response.
# LLM_JSON_MODE=json_object
